# Copy to .env for local overrides, or set these as real environment
# variables in your hosting provider's dashboard (e.g. Render's
# Environment tab). Never commit a file containing real values -- this
# file documents the shape only, every value below is a placeholder.

# Required. Postgres connection string (psycopg2 format). For local Docker
# Compose this is already set in docker-compose.yml and you don't need this
# file at all. For a hosted deployment, this is the target database's
# connection string (e.g. from Neon's dashboard) -- store it only as a
# provider environment variable or in a local, gitignored .env, never in
# committed config, never printed in logs or reports.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Comma-separated list of origins allowed to call this API from a browser.
# Defaults to the two local Vite dev origins if unset -- a real deployment
# MUST set this explicitly to its actual frontend origin(s), e.g.:
# ALLOWED_ORIGINS=https://accesspath.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# "full" (default) serves the complete local Seattle dataset. Only the
# free-tier hosted demo sets this to "hosted_subset" -- see
# docs/deployment.md and backend/scripts/build_hosted_subset.py. Setting
# this to hosted_subset without actually importing the subset data (or on
# a database that has the full dataset) does NOT shrink the served area --
# it only changes what GET /deployment-info discloses to the frontend, so
# keep this in sync with which database is actually connected.
DEPLOYMENT_MODE=full
